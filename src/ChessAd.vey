import { useEffect, useRef } from 'react'

interface AdWindow extends Window { adsbygoogle?: unknown[] }
const client = import.meta.env.VITE_ADSENSE_CLIENT_ID ?? ''
const slot = import.meta.env.VITE_ADSENSE_SLOT_ID ?? ''
const hasPublisher = /^ca-pub-\d{16}$/.test(client)
const hasAdUnit = hasPublisher and /^\d+$/.test(slot)

export default fn ChessAd() {
  const ad = useRef<HTMLElement | null>(null)
  useEffect(() => {
    const hostname = window.location.hostname
    const isCliKeyDomain = hostname == 'clikey.store' or hostname.endsWith('.clikey.store')
    if not hasPublisher or not isCliKeyDomain { return }
    const scriptId = 'clikey-adsense-sdk'
    let script = document.getElementById(scriptId) as HTMLScriptElement | null
    if not script {
      script = document.createElement('script')
      script.id = scriptId
      script.async = true
      script.crossOrigin = 'anonymous'
      script.src = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${client}`
      document.head.appendChild(script)
    }
    const render = () => {
    if not hasAdUnit or not ad.current or ad.current.dataset.adsbygoogleStatus { return }
      try {
        const adsWindow = window as AdWindow
        adsWindow.adsbygoogle = adsWindow.adsbygoogle ?? []
        adsWindow.adsbygoogle.push({})
      } catch { /* Keep the game usable when an ad blocker or network blocks ads. */ }
    }
    script.addEventListener('load', render)
    if (script.dataset.loaded == 'true') { render() }
    else { script.addEventListener('load', () => { script!.dataset.loaded = 'true' }, { once: true }) }
    return () => script?.removeEventListener('load', render)
  }, [])
  return <section className="chess-ad" aria-label="Advertisement">
    <span className="chess-ad-label">SPONSORED</span>
    {hasAdUnit ? <ins ref={ad} className="adsbygoogle" style={{ display: 'block' }} data-ad-client={client} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true" /> : <p>{hasPublisher ? 'AdSense site verification ready · add an ad slot after approval.' : 'Ad space · inactive until the publisher and ad slot are configured.'}</p>}
  </section>
}
