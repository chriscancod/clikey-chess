export style "clikey-game-hub" {
.game-hub { --hub-paper: #f2efe6; --hub-ink: #273a31; min-height: 100dvh; background: var(--hub-paper); color: var(--hub-ink); font-family: -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
.game-hub a { color: inherit; }
.hub-bar { min-height: 78px; padding: 18px clamp(22px,6vw,100px); display:flex; align-items:center; justify-content:space-between; gap:20px; border-bottom:1px solid #d8d6c9; }
.hub-brand { font-size:25px; font-weight:800; text-decoration:none; letter-spacing:-1px; }.hub-brand span { font-weight:400; color:#748072; font-size:17px; letter-spacing:0; }.hub-bar > a:last-child { font-size:13px; text-underline-offset:5px; }
.hub-note,.hub-eyebrow { font-size:10px; font-weight:700; letter-spacing:2px; }.hub-note { color:#778476; }
.hub-home { max-width:1190px; margin:auto; padding:65px 30px 28px; }.hub-heading { margin-bottom:48px; }.hub-heading h1 { font:500 clamp(48px,6vw,80px)/1.04 Georgia,serif; letter-spacing:-3px; margin:20px 0; }.hub-heading em { color:#6d805c; }.hub-heading p { color:#728071; line-height:1.8; font-size:16px; }
.hub-games { display:grid; grid-template-columns:1fr 1fr; gap:30px; }.hub-card { border:1px solid #d2d2c3; border-radius:16px; overflow:hidden; background:#faf8f0; }.hub-art { height:255px; position:relative; overflow:hidden; }.castle-art { background:radial-gradient(ellipse at 50% 100%,#484337,#171d24 75%); }.hub-moon { position:absolute; width:92px; height:92px; border-radius:50%; background:#d5c9a0; top:25px; right:75px; }.hub-tower { position:absolute; width:100px; height:230px; bottom:0; background:repeating-linear-gradient(0deg,transparent 0px,transparent 29px,#4c4b45 30px),#303740; border-top:9px dashed #84816a; box-shadow:inset 8px 0 #454b50; }.t1 { left:10%; height:160px; }.t2 { left:40%; height:200px; width:125px; }.t3 { right:8%; height:150px; }.hub-sword { position:absolute; font-size:100px; color:#edd09b; left:50%; top:35%; transform:translateX(-50%); text-shadow:0 5px 35px #be975c; }.hub-art-caption { position:absolute; bottom:15px; left:24px; color:#f3e9cc; letter-spacing:3px; font-size:9px; font-weight:600; }
.chess-art { background:radial-gradient(ellipse at 40% 20%,#d9dcc8,#84977b); display:grid; place-items:center; }.hub-mini-board { display:grid; grid-template-columns:repeat(4,50px); border:7px solid #4c624d; transform:rotate(-13deg); box-shadow:12px 18px 25px #45503c40; }.hub-mini-board span { width:50px;height:50px;display:grid;place-items:center;font:46px Georgia,serif;color:#233b2e; }.hub-mini-board .light { background:#f1e9d5; }.hub-mini-board .dark { background:#899a78; }.chess-art .hub-art-caption {color:#233b2e;}
.hub-card-body { padding:28px; }.hub-card-body h2 { font:500 29px Georgia,serif; margin:14px 0; }.hub-card-body p { min-height:55px; font-size:14px; line-height:1.8; color:#6b7769; }.hub-tags { display:flex;flex-wrap:wrap;gap:8px; margin:20px 0; }.hub-tags span { border:1px solid #dcded2; border-radius:20px; padding:6px 10px; font-size:10px; color:#677662; }.hub-play { display:flex;justify-content:space-between;align-items:center;width:100%;padding:17px 20px;background:#324f3f;color:#fff9e9;border-radius:8px;font-size:14px; }.castle-card .hub-play { background:#554b3c; }.hub-play:hover {filter:brightness(1.14);}.game-hub button:focus-visible,.game-hub a:focus-visible {outline:3px solid #b18141;outline-offset:4px;}
.hub-footer { margin-top:30px; display:flex; justify-content:space-between; gap:30px; align-items:center; color:#74816e; font-size:11px; line-height:1.8; }.hub-footer p {max-width:600px;}.hub-footer span {font-size:9px;letter-spacing:1px;white-space:nowrap;}
.hub-playing .hub-bar { display:none; }.hub-game-shell { height:100dvh; background:#14131b; }.hub-game-nav { height:62px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 24px;background:#f2efe6;position:relative;z-index:5; }.hub-game-nav button {background:transparent;color:#334c3b;min-height:40px;font-size:13px;}.hub-game-nav strong {font-size:13px;letter-spacing:1px;}.hub-castle-stage {position:relative;height:calc(100dvh - 62px);padding-bottom:32px;}.hub-castle-stage iframe {border:0;width:100%;height:100%;display:block;}.hub-controls {margin:0;position:absolute;bottom:0;left:0;right:0;height:32px;color:#a9aa9b;font-size:11px;text-align:center;line-height:32px;}.hub-load {position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;background:#14131b;color:#dac18a;z-index:2;gap:15px;padding:25px;text-align:center;}.hub-chess-shell .chess-page {top:62px;}.hub-chess-shell .chess-topbar {display:none;}
.hub-dialog-backdrop {position:fixed;inset:0;background:#0b151ccc;display:grid;place-items:center;z-index:50;padding:25px;}.hub-dialog {max-width:440px;padding:32px;background:#f2efe6;border-radius:14px;box-shadow:0 18px 90px #0008;}.hub-dialog h2 {font:30px Georgia,serif;margin-top:0;}.hub-dialog p {line-height:1.7;color:#64705e;}.hub-dialog > div {display:flex;gap:10px;margin-top:25px;}.hub-dialog button {padding:13px 18px;border:1px solid #69775e;border-radius:7px;background:#e2e5d9;color:#2d4634;}.hub-dialog button:last-child {background:#344e3e;color:#fff;}
@media(max-width:700px) { .hub-note {display:none;}.hub-home {padding:36px 18px 20px;}.hub-heading h1 {letter-spacing:-1.5px;}.hub-games {grid-template-columns:1fr;gap:22px;}.hub-art {height:230px;}.hub-footer {display:block;}.hub-controls {font-size:9px;}.hub-game-nav {padding:8px 12px;}.hub-game-nav strong {font-size:10px;} }
@media(prefers-reduced-motion:reduce) { .game-hub * {scroll-behavior:auto;} }
}
