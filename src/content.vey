style {
.site-reading { width: min(780px, calc(100% - 40px)); margin: 0 auto; padding: 46px 0; color: #263d32; font-size: 17px; line-height: 1.8; overflow-wrap: anywhere; }
.site-reading h1 { font: 500 clamp(30px,5vw,46px)/1.2 Georgia,serif; margin: 12px 0 28px; }
.site-reading h2 { font: 500 28px/1.3 Georgia,serif; margin: 32px 0 14px; }
.site-reading h3 { font: 500 23px/1.3 Georgia,serif; }
.site-reading p { margin: 0 0 20px; }
.site-reading li { margin-bottom: 12px; }
.site-reading a, .site-links a { color: #215c41; text-decoration: underline; text-underline-offset: 4px; }
.site-links { display: flex; justify-content: center; flex-wrap: wrap; gap: 15px 24px; padding: 24px; border-top: 1px solid #c9cec4; background: #f2efe6; font-size: 14px; line-height: 1.6; }
.site-document { min-height: 100vh; background: #f7f5ee; }
.site-document header { padding-top: 24px; }
.site-brand { display: block; width: fit-content; margin: 0 auto 20px; color: #263d32; font: 600 30px Georgia,serif; text-decoration: none; }
.site-eyebrow { font-size: 11px; letter-spacing: .12em; font-weight: 700; }
.site-reading :focus-visible, .site-links :focus-visible, .site-brand:focus-visible { outline: 3px solid #215c41; outline-offset: 5px; }
@media (max-width: 480px) { .site-reading { font-size: 16px; padding: 28px 0; } .site-links { gap: 13px 18px; } }
}
