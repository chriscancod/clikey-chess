import Chess from './Chess'
import GameHub from './GameHub'

export const pages = [
  { path: '/', title: 'Clikey Chess — play and learn on your device', description: 'Play local chess or challenge the on-device opponent. Learn the controls, special moves and a practical opening routine.' },
  { path: '/hub/', title: 'Clikey Games — Chess and ONE MORE FLOOR', description: 'Two playable browser games, with original guides to controls, strategy and saving progress.' },
  { path: '/guides/chess/', title: 'Clikey Chess guide — controls, special moves and practice', description: 'Learn how Clikey handles legal moves, castling, promotion, undo and playing the computer, with a practical first-game exercise.' },
  { path: '/guides/one-more-floor/', title: 'ONE MORE FLOOR guide — ammo, checkpoints and saved credits', description: 'A practical guide to Ashen Keep: movement, manual shooting, ammo drops, BANK or RISK, heroes and local progress.' },
  { path: '/about/', title: 'About Clikey — a small browser-game collection', description: 'What Clikey offers, how the two games differ, and the limits of local browser play.' },
  { path: '/privacy/', title: 'Clikey privacy and storage', description: 'What stays on your device, what the hosting provider receives, and the current advertising status.' },
  { path: '/help/', title: 'Clikey help — controls, saving and reporting problems', description: 'Troubleshoot loading, sound, lost saves and chess controls, or report a reproducible game problem.' },
]

export fn SiteLinks() {
  return <nav className="site-links" aria-label="Site information"><a href="/">Play chess</a><a href="/hub/">Game collection</a><a href="/guides/chess/">Chess guide</a><a href="/guides/one-more-floor/">Castle guide</a><a href="/about/">About</a><a href="/help/">Help & contact</a><a href="/privacy/">Privacy & storage</a></nav>
}

export fn ChessGuide() {
  return <>
    <p>Clikey Chess is a board you can share on one device, with an optional computer opponent. There are no online matches or accounts. Use this guide alongside the board: you can try an idea, undo it, and compare another move.</p>
    <h2>Start a game and read the board</h2>
    <p>White moves first. Select a piece, then select a highlighted destination. Dots show empty legal destinations; marked enemy pieces can be captured. Selecting an empty unmarked square clears your selection. You cannot make a move that leaves your king in check.</p>
    <p>Choose Two players to pass the device after each turn. In Vs computer, choose White or Black. Choosing a color starts a fresh position; Black lets the computer make the first move. The opponent calculates on your device, so it may take a moment on slower hardware. It is a practice opponent, not a rated online player.</p>
    <h2>What the controls change</h2>
    <ul><li>Flip board rotates your view without changing whose turn it is.</li><li>New game clears the current position and move history.</li><li>Undo move removes one move, not a whole pair of turns. In computer mode the opponent may respond again when its turn returns.</li><li>The promotion selector chooses the piece a pawn becomes on the last rank. Set it before moving the pawn there; queen is the default.</li></ul>
    <h2>Special moves you can try</h2>
    <p>To castle, select the king and choose its two-square destination. The king and relevant rook must not have moved, the squares between them must be empty, and the king cannot start in check or pass through an attacked square. Moving a rook back to its original square does not restore castling rights.</p>
    <p>En passant is available only on the move immediately after an opposing pawn advances two squares beside your pawn. Your pawn moves diagonally into the square it passed over, and the adjacent pawn is removed. If you make another move first, that opportunity is gone.</p>
    <h2>A useful first ten minutes</h2>
    <p>Begin in Two players mode. Move White's pawn from e2 to e4, then Black's pawn from e7 to e5. Develop the g1 knight to f3 and the b8 knight to c6. Before each next move, ask: is my king attacked, is one of my pieces undefended, and what did the last move threaten? This routine is more useful than memorizing a long opening sequence.</p>
    <p>Try an early queen move and notice how many opposing pieces can gain time by attacking it. Undo and develop a knight or bishop instead. The goal of this exercise is to compare positions, not to claim every queen move is wrong.</p>
    <h2>Game status, notation and limits</h2>
    <p>The status panel distinguishes check, checkmate and draws recognized by this implementation. The move list records algebraic notation: N is a knight, B a bishop, R a rook, Q a queen and K a king. A pawn move usually starts with its destination file. Use the highlighted last-move squares to follow the computer's reply.</p>
    <p>This is a casual practice board, not a tournament arbiter. It has no clocks, online rating, account history or match export. A page refresh starts over; an installed browser window does not add cloud saving. If you find a rules problem, report the starting position and the moves needed to reproduce it through <a href="/help/">Help & contact</a>.</p>
    <p><a href="/">Open the chess board →</a></p>
  </>
}

export fn CastleGuide() {
  return <>
    <p>ONE MORE FLOOR is a climb through Ashen Keep. You move, aim your survival decisions around the enemies on the floor, and shoot manually. A successful floor gives you another upgrade decision; checkpoints ask whether to secure a score or keep climbing.</p>
    <h2>Controls for the browser version</h2>
    <ul><li>Keyboard: WASD or arrow keys move; F shoots; Space dashes; Esc pauses.</li><li>Touch: use the movement joystick and the on-screen shoot and dash controls.</li><li>Controller mappings: left stick moves, RT or right shoulder shoots, A dashes, Start pauses. Browser and controller support vary; keyboard is the fallback.</li></ul>
    <p>Start with space around your character. Hold a direction, fire briefly, and watch how quickly the ammunition display falls. Dashing is a way out of a closing gap; using it as soon as it is available can leave you without an escape when enemies converge.</p>
    <h2>Ammunition changes how you fight</h2>
    <p>Firing spends ammunition. Normal defeated enemies drop packs worth three rounds and bosses drop ten. Walk over a pack to collect it. Packs stay on the current floor when you are full, but do not carry over as objects to the next floor. Your remaining ammunition does carry between floors.</p>
    <p>At zero ammo, a short period of active play restores three rounds. This recovery also works when no enemies remain, so running dry does not require restarting the run. Pausing does not advance active-play recovery. A useful habit is to leave a nearby pack until you have room for it, then circle back rather than standing still to shoot.</p>
    <h2>BANK or RISK is a score decision</h2>
    <p>At ten-floor checkpoints, BANK ends the run and keeps the score you have secured. RISK continues with increased scoring. Dying during a risk stretch preserves the secured portion but only a quarter of the points earned during that stretch. Treat the checkpoint as a decision about the current run, rather than a requirement to continue indefinitely.</p>
    <p>For a first attempt, aim to learn one enemy pattern and return safely from a checkpoint. Bats begin appearing from floor four and weave toward you. Warlocks arrive from floor seven, keep their distance and cast a spread. Moving into open space before firing gives you more options than backing into a corner.</p>
    <h2>Credits, heroes and styles</h2>
    <p>Clearing a floor earns 15 plus three times the floor number in credits, with that floor component capped at floor thirty. Boss floors add eighty. Credits save as they are earned and survive the end of a run; they are separate from the score you bank or risk.</p>
    <p>Shop & Customize offers heroes and outfit tints. Storm Mage costs 250 credits, Iron Warden 400 and Veil Ranger 650. The original style is free. Owned equipment can be selected again without paying twice. Credits are earned in the game, have no cash value and cannot be transferred into chess.</p>
    <h2>Where your progress lives</h2>
    <p>The browser game saves on the current browser and device. Clearing site storage, using a private window, or switching browsers can leave you with a fresh save. Browser and native phone progress are separate; there is no account synchronization. Installing the hub as an app does not make the game work offline.</p>
    <p>If the game does not load, try the <a href="/one-more-floor/index.html">direct game page</a> and read <a href="/help/">the loading checks</a>. The game requires a browser with WebAssembly and WebGL 2 support.</p>
    <p><a href="/hub/">Choose ONE MORE FLOOR in the game collection →</a></p>
  </>
}

fn About() {
  return <><p>Clikey is a small browser-game collection: a chess board for local play and practice, and ONE MORE FLOOR, a castle-climbing arcade game. You can open either game without creating an account.</p><h2>Two different ways to play</h2><p>Chess is for a shared device or a match against the on-device computer. ONE MORE FLOOR is a real-time game about movement, ammunition and checkpoint choices. The collection links them, but does not combine their scores, currency or saves.</p><h2>What this site provides</h2><p>The games are accompanied by guides written for these implementations: how the controls behave, what gets saved, and what to try when something goes wrong. Game changes and site fixes are recorded in the <a href="https://github.com/chriscancod/clikey-chess/commits/main/">public project history</a>. The site uses Vey with React; the castle browser game is exported from Godot.</p><p>There are no online chess rooms, paid credit purchases or cross-device accounts here. The browser window is the game session, so please read the storage notes before clearing data or switching devices.</p><h2>Corrections and feedback</h2><p>If a guide does not match a control or a game behaves unexpectedly, a reproducible example helps us correct it. Use <a href="/help/">Help & contact</a> for the project's issue tracker. Do not include personal information or private saved data in a public report.</p></>
}
fn Privacy() {
  return <><p>Updated October 24, 2026. This page describes the browser website, not a native mobile app.</p><h2>Games and storage</h2><p>Clikey Chess keeps its position and move list in page memory. Refreshing or closing the page loses that match. The computer opponent calculates moves locally rather than submitting your position to an online chess service.</p><p>ONE MORE FLOOR stores game progress and settings using the browser's storage for this site. This includes earned credits, owned equipment and progress. There is no shared account or cloud-save feature. Clearing this site's storage removes that browser's progress; there is no recovery service for a deleted local save.</p><h2>Website requests</h2><p>Your browser requests the site files from GitHub Pages and its delivery infrastructure. The hosting provider receives technical request information needed to deliver those files, such as an IP address. See <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">GitHub's privacy statement</a> for its practices. Clikey does not add an analytics SDK, sign-up form or tracking pixel in this release.</p><h2>Advertising</h2><p>Google ad loading and display placements are disabled across this website in this release. No advertising consent is requested because this release does not load the advertising SDK. If advertising returns, this notice and the required consent controls must be updated before ad code is enabled. An ads.txt file identifies an advertising seller; that text file alone does not load an ad or set a cookie.</p><h2>Your choices and public reports</h2><p>You can clear local game data through your browser's site-storage settings. That action does not delete the hosting provider's logs. Contact and bug reports use the project's public GitHub issue tracker; GitHub manages information you submit there under its own policies. Do not post passwords, personal details or private save files. Browser extensions and external links may have their own data practices.</p></>
}
fn Help() {
  return <><h2>Chess: a piece will not move</h2><p>Select the side whose turn is shown in the status panel. The highlighted destinations are legal moves for the selected piece. A pinned piece may be unable to leave its file because doing so exposes the king. In computer mode, wait for the computer to finish before selecting another move. If you want to control both sides, choose Two players.</p><h2>Castle: blank screen or loading failure</h2><p>Open the <a href="/one-more-floor/index.html">game directly</a> to separate a game-loading issue from the hub frame. Use a current browser with WebAssembly and WebGL 2 enabled. Allow the initial game files time to download. A school or managed device may block those features; another browser or device can help identify that restriction.</p><p>Try reloading the page before clearing site storage. Clearing storage can erase your castle progress. If an update appears stale, close other open game tabs and reload. Installing the website does not provide an offline copy.</p><h2>Sound and controls</h2><p>Click or tap into the game before testing sound; browsers may require a user gesture to start audio. Check the in-game music/effects settings and your browser's tab mute control. If a connected controller is not recognized, use keyboard or touch. Controller mapping support differs across browser and hardware combinations.</p><h2>Progress is missing</h2><p>Check that you are using the same browser, device and normal browsing profile. Private windows and another browser do not share a save. Phone-app saves are separate from browser saves. A chess match is not saved after a refresh. There is no server account from which to restore deleted local progress.</p><h2>Contact the project or report a bug</h2><p>Use the <a href="https://github.com/chriscancod/clikey-chess/issues/new">Clikey project issue tracker</a> (a GitHub account is required). Include the page URL, browser/version, the controls you used, what you expected, and what actually happened. For chess, include the move sequence. For the castle game, include the floor and whether the issue happened after pausing or changing menus.</p><p>Reports are public. Do not include your real name, email, passwords or private save data. No in-site chat or support form is provided. You can also check <a href="https://github.com/chriscancod/clikey-chess/issues">existing reports</a> before opening a duplicate.</p></>
}

export default fn SiteApp(props: { path: string }) {
  const requested = props.path.replace(/index\.html$/, '')
  const path = requested.endsWith('/') ? requested : `${requested}/`
  const page = pages.find(p => p.path == path)
  if path == '/' {
    return <><Chess /><section className="site-reading" aria-labelledby="learn-title"><span className="site-eyebrow">PLAY, THEN TRY ANOTHER IDEA</span><h2 id="learn-title">Get more from the chess board</h2><p>Select a piece to see legal destinations. Play on one device with a friend, or choose Vs computer and pick a color. New game resets the board; Undo removes one move. Your match stays in this page and starts fresh when you reload.</p><p>For a first practice round, try e2–e4, e7–e5, Ng1–f3 and Nb8–c6 in Two players mode. Ask what each move defends and what it threatens. Develop a knight or bishop before moving the same piece again, then compare the result with a different choice using Undo.</p><p><a href="/guides/chess/">Read the full chess guide: special moves, controls and a practice routine →</a></p><h3>Looking for a different pace?</h3><p>ONE MORE FLOOR trades turns for real-time movement. Climb a castle, manage ammunition and choose whether to bank a score or risk the next stretch. Its credits and save are separate from chess.</p><p><a href="/guides/one-more-floor/">Read the castle guide</a> or <a href="/hub/">open the game collection</a>.</p></section><SiteLinks /></>
  }
  if path == '/hub/' { return <><GameHub /><section className="site-reading"><h2>Before you play</h2><p>Chess is a turn-based local board with an optional computer opponent. ONE MORE FLOOR is a real-time castle climb with manual shooting, local saves and earned equipment. Neither needs an account. Pick a guide for controls, practical first steps and the limits of each game's saving.</p><p><a href="/guides/chess/">Learn Clikey Chess</a> · <a href="/guides/one-more-floor/">Learn ONE MORE FLOOR</a></p></section><SiteLinks /></> }
  return <div className="site-document"><header><a className="site-brand" href="/">clikey.</a><SiteLinks /></header><main className="site-reading"><span className="site-eyebrow">CLIKEY · FIELD NOTES</span><h1>{page ? page.title.split(' — ')[0] : 'Page not found'}</h1>{path == '/guides/chess/' ? <ChessGuide /> : path == '/guides/one-more-floor/' ? <CastleGuide /> : path == '/about/' ? <About /> : path == '/privacy/' ? <Privacy /> : path == '/help/' ? <Help /> : <p>This page does not exist. <a href="/">Return to chess</a> or choose a guide from the navigation.</p>}</main><footer className="site-reading"><p>Clikey · Games and practical guides. <a href="/help/">Report a problem</a>.</p></footer></div>
}
